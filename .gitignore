# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Virtualenv / uv
.venv/
.uv/

# Build artefacts
build/
dist/
*.whl

# raven runtime
.raven/

# Example runs write their SQLite DB next to the script
# (examples/01-hello-world/hello.db, 02/bus.db, 03/newsdesk.db,
# 04/incident.db) plus WAL/SHM/journal siblings.
examples/**/*.db
examples/**/*.db-wal
examples/**/*.db-shm
examples/**/*.db-journal

# v1 legacy (local files may linger)
claude-bus.db
claude-bus.db-*
raven.db
raven.db-journal
raven.db-wal
raven.db-shm
raven.yaml
*.signal

# Test / coverage artefacts
.coverage
.coverage.*
htmlcov/

# IDE
.vscode/
.idea/
*.swp
*~

# Local agent / tooling state
.claude/
notes/

# OS
.DS_Store
Thumbs.db
